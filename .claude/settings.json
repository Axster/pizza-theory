{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run run-dev:*)",
      "Bash(node --experimental-strip-types utils/tests/expert_matrix.ts)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(node ./scripts/run-dev.js:*)",
      "Bash(adb devices:*)",
      "Bash(xcrun xctrace list devices)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx eas:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/algorithm-doc-guard.js\""
          }
        ]
      }
    ]
  }
}
